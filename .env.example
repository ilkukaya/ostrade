# Copy this file to .env for local development and fill in real values.
# Never commit .env — it is already gitignored.
#
# For Netlify, set these under Site configuration > Environment variables
# instead of committing a .env file.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas free tier, or the local Docker Compose instance
# (required)
# ---------------------------------------------------------------------------
# Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# Local Docker Compose (docker compose up -d mongodb):
MONGODB_URI=mongodb://root:example@localhost:27017/openstock?authSource=admin

# ---------------------------------------------------------------------------
# Auth — Better Auth (required)
# ---------------------------------------------------------------------------
# Generate a random secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Private terminal access (optional but strongly recommended)
# ---------------------------------------------------------------------------
# When set, only this email address may sign up or sign in — every other
# sign-up attempt is rejected. Leave unset only while creating the very
# first (owner) account, then set it. See docs/architecture.md.
AUTHORIZED_EMAIL=

# ---------------------------------------------------------------------------
# Optional integrations — the app boots and core features work without these
# ---------------------------------------------------------------------------

# Market data — Stooq and Yahoo Finance need NO API key and NO account, and
# are the primary/fallback source for every daily EOD bar the app uses
# (scanner, stock analysis, backtesting, candidate tracking) — see
# docs/market-data.md. Finnhub is OPTIONAL, zero-cost-first enrichment only:
# richer live quotes, company financials, and news, tried first when
# configured and silently skipped otherwise (local search and Yahoo-derived
# quotes/company names still work with this unset — see docs/market-data.md's
# "Finnhub is optional" section). Never upgrade this, or any other market-data
# provider, to a paid plan without the owner's explicit approval.
# Server-side only — do NOT prefix with NEXT_PUBLIC_, this key must never
# reach the browser bundle.
# FINNHUB_API_KEY=
# Optional override; defaults to https://finnhub.io/api/v1
# FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Sentiment insights on the stock detail page (Reddit/X/news/Polymarket).
# ADANOS_API_KEY=
# ADANOS_API_BASE_URL=https://api.adanos.org

# AI-personalized welcome email + natural-language setup summaries (never
# required for core analysis, which is always deterministic).
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3
# SIRAY_API_KEY=

# Background jobs (welcome email, 5-minute price-alert check, candidate
# outcome tracking). Only needed once deployed, from the Inngest Cloud
# dashboard for this app; run `npx inngest-cli@latest dev` for local
# development instead. Both are read automatically by the Inngest SDK
# (INNGEST_EVENT_KEY is never referenced directly in this codebase) and both
# are optional in the sense that matters most: every place this app sends an
# Inngest event wraps the call in its own try/catch so a missing/invalid key
# never blocks sign-up or any other core action, it only means that specific
# background job doesn't run.
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Outbound email (welcome email, password reset). Without these, password
# reset emails cannot be sent and sign-up simply skips the welcome email.
# NODEMAILER_EMAIL=youraddress@gmail.com
# NODEMAILER_PASSWORD=your_gmail_app_password
